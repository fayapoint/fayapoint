# ⚠️ APOSENTADO EM 29/07/2026 — mantido so como receita de rollback.
#
# Esta unit rodava `docker exec` como ROOT dentro do container. O Hermes
# roda como uid 10000, entao todo log criado por ela nascia root:root e o
# gateway nao conseguia mais abrir /opt/data/logs/agent.log no restart
# seguinte — PermissionError em laco (foi o que derrubou o gateway durante
# o update de 29/07). Era tambem a origem dos 46.904 reinicios de 21-28/07.
#
# AGORA: o dashboard e supervisionado pelo s6 DENTRO do container, que faz
# `s6-setuidgid hermes` — nada mais escreve como root. Ligado pelas env do
# container: HERMES_DASHBOARD=1, HERMES_DASHBOARD_HOST=100.111.28.77,
# HERMES_DASHBOARD_PORT=9119, HERMES_DASHBOARD_TUI=1 (ver
# /root/kirmes/_bak_2907/kirmes.env.new na VPS).
#
# ⚠️ --insecure NAO desliga mais o portao de autenticacao (endurecimento de
# jun/2026). Quem satisfaz o portao hoje e o bloco dashboard.basic_auth do
# config.yaml (usuario `ricardo`).
#
# Para reverter: systemctl enable --now hermes-dashboard.service e tirar as
# env HERMES_DASHBOARD* do container.

[Unit]
Description=Hermes Agent Web Dashboard (Tailscale-only, porta 9119) [APOSENTADO 29/07]
After=docker.service tailscaled.service
Requires=docker.service

[Service]
Type=simple
# Binda APENAS no IP Tailscale da VPS (100.111.28.77): acessivel so pelo tailnet
# do Ricardo. --insecure e exigido pelo hermes p/ bind fora de localhost, mas a
# exposicao real e limitada a interface tailscale0. --tui liga a aba Chat.
ExecStartPre=/bin/sh -c 'until docker inspect -f {{.State.Running}} kirmes | grep -q true; do sleep 3; done'
# Mata instancia orfa dentro do container antes de subir a nossa.
#
# Sem esta linha o servico ficava em laco eterno: parar a unit mata o `docker
# exec` no HOST, mas o processo DENTRO do container sobrevive e continua com a
# porta 9119. O ExecStart seguinte entao morria com "address already in use" a
# cada 10s -- 46.904 reinicios entre 21/07 e 28/07/2026, com o painel no ar o
# tempo todo servido pelo orfao, que ninguem gerenciava.
#
# Sem `sh -c` de proposito: assim o processo no container e o proprio pkill, que
# nao casa consigo mesmo. Com wrapper, o shell teria o padrao na propria linha
# de comando e se mataria antes de agir.
ExecStartPre=-/usr/bin/docker exec kirmes pkill -f "hermes dashboard"
ExecStart=/usr/bin/docker exec -e HERMES_DASHBOARD_TUI=1 kirmes /opt/hermes/.venv/bin/hermes dashboard --host 100.111.28.77 --port 9119 --insecure --no-open --tui
# E na saida nao deixa orfao para tras -- a origem do problema acima.
ExecStopPost=-/usr/bin/docker exec kirmes pkill -f "hermes dashboard"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
