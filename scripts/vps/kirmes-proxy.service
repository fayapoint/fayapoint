[Unit]
Description=Kirmes Model Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kirmes
Environment=OPENROUTER_KEY=<REDACTED — chave real só na VPS em /etc/systemd/system/kirmes-proxy.service>
# ⚠️ ESTAS LINHAS MANDAM MAIS QUE O model_proxy.py. Os defaults do Python só
# valem quando a variável NÃO está aqui. Em 02/08 o código migrou para o
# deepseek e este arquivo ficou nos Gemini por cinco dias — a VPS estava certa,
# a cópia versionada é que mentia, e foi ela que quase me fez "consertar" o que
# já estava certo. Conferido em 07/08 contra o /health real da VPS.
Environment=PRIMARY_MODEL=~deepseek/deepseek-v4-flash-latest
Environment=FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
Environment=PREMIUM_MODEL=~deepseek/deepseek-v4-flash-latest
Environment=PROXY_PORT=7860
ExecStart=/usr/bin/python3 /root/kirmes/model_proxy.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
