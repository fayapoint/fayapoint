# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials
PROJECT_CREDENTIALS.md

# Local Netlify folder
.netlify

# playwright artifacts
.playwright-cli/
output/
scripts/arcade/arcade_loops_run*.log

# saida de scripts de geracao (logs, manifests de lote, cache do python).
# Sao rastro de execucao, nao fonte: o que importa esta em public/ e no Atlas.
scripts/**/*.log
scripts/**/__pycache__/
scripts/cursos/*-manifest*.json
scripts/cursos/audit_courses_raw.json

# PNGs das capas geradas localmente — o que vale é a URL no Cloudinary
_capas_novas/*.png

# Artes intermediárias das capas de curso — o que vale é o que subiu para o
# Cloudinary (fayai/courses/<slug>/capa-v2), regerável por scripts/gerar-capas-cursos.mjs
scripts/_capas_v2/

# Mesma razão, um degrau adiante: os livros montados. 2,7 MB de webp que o
# gerar-capas-livro.mjs refaz igual a partir do hash do slug, e cuja versão
# publicada é a do Cloudinary. O arquivo de trabalho mora em D:\fayai\Cursos\capas.
scripts/_capas_livro/

# Sobras de geração local (mascote 3D, capturas de tela, testes de logo). São
# dezenas de MB de binário regenerável — ver scripts/arcade/.
_capas_novas/_logo_cache/
_capas_novas/_teste/
_capas_novas/mascote/
_capas_novas/pessoa/
_capas_novas/telas/

# rascunho de sessão (scripts de auditoria/estado). Não é fonte.
_tmp/

# saida de execucao do vigia (log de rodada). O que vale e base-precos.json.
scripts/precos/*.log

# Bancada do laço de críticos (skill gauntlet-loop): rodadas, capturas e
# notas de crítico de UMA sessão. É rascunho de trabalho, não é fonte.
.gauntlet/
